# mac と Linux コンテナでエディタ設定が揺れないように明示する
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = tab
insert_final_newline = true
trim_trailing_whitespace = true

# YAML はタブを使えない
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Claude Code が自動で書き戻すファイル。ツールの出力形式（スペース2）に合わせて
# 手編集との往復で差分が出ないようにする
[.claude/**.json]
indent_style = space
indent_size = 2

# Markdown は行末スペースが改行の意味を持つ
[*.md]
trim_trailing_whitespace = false
